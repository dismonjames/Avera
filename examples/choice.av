#std.io

action main(): I32 will
    :m = .some(42)
    match m will
        .some(v) =>
            print("got:", v)
        .none =>
            print("nothing")
    finish
    :n = .none()
    match n will
        .some(v) =>
            print("got:", v)
        .none =>
            print("nothing")
    finish
    return 0
finish
